@startuml Use Case Diagram - Sistem Pengajuan Cuti

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor #F1F8E9
    BorderColor #689F38
    ArrowColor #33691E
}
skinparam actor {
    BackgroundColor #E3F2FD
    BorderColor #1565C0
}

title Use Case Diagram - Sistem Pengajuan Cuti Karyawan

rectangle "Sistem Pengajuan Cuti" {

    usecase "Login" as UC1
    usecase "Logout" as UC2
    usecase "Kelola Profil" as UC3

    usecase "Lihat Dashboard" as UC4
    usecase "Ajukan Cuti" as UC5
    usecase "Lihat Status Pengajuan" as UC6
    usecase "Edit Pengajuan Cuti" as UC7
    usecase "Batalkan Pengajuan" as UC8

    usecase "Kelola Jenis Cuti" as UC9
    usecase "Lihat Semua Pengajuan" as UC10
    usecase "Setujui Pengajuan" as UC11
    usecase "Tolak Pengajuan" as UC12
    usecase "Lihat Laporan" as UC13
    usecase "Kelola Kuota Cuti" as UC14
}

actor "Karyawan" as Karyawan
actor "Admin" as Admin

Karyawan --> UC1
Karyawan --> UC2
Karyawan --> UC3
Karyawan --> UC4
Karyawan --> UC5
Karyawan --> UC6
Karyawan --> UC7
Karyawan --> UC8

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC9
Admin --> UC10
Admin --> UC11
Admin --> UC12
Admin --> UC13
Admin --> UC14

UC5 ..> UC6 : <<include>>
UC11 ..> UC6 : <<include>>
UC12 ..> UC6 : <<include>>
UC7 ..> UC6 : <<include>>

@enduml
